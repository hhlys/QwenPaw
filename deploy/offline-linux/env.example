# QwenPaw offline Linux runtime configuration.
# Copy to env.sh and edit if needed.

# Safe default: only listen on localhost. Publish through 4A/Nginx/gateway if
# remote browser access is required.
QWENPAW_HOST=127.0.0.1
QWENPAW_PORT=8080

# Keep user data inside the extracted bundle by default. For production, you
# may point these to a persistent directory, e.g. /data/qwenpaw.
QWENPAW_WORKING_DIR=
QWENPAW_SECRET_DIR=

# Extra environment variables can be appended below, for example:
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=127.0.0.1,localhost
